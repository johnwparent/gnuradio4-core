@PACKAGE_INIT@

# plugin API version that versions the shared plugin/manifest install paths
set(GR_PLUGIN_API_VERSION "@GR_PLUGIN_API_VERSION@")

include(CMakeFindDependencyMacro)

# Optional transitive dependencies of exported targets.
if(@ENABLE_TBB@)
  find_dependency(TBB)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/gnuradio4Targets.cmake")

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/gnuradio4PluginTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/gnuradio4PluginTargets.cmake")
endif()

# add_ut_test()/setup_test() for downstream test suites; requires a target named 'ut'
# (Boost.UT) in the consuming project. Guarded so installs predating it still configure.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GnuRadioTestHelpers.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/GnuRadioTestHelpers.cmake")
endif()

# gr_configure_innosetup_installer() so downstream GR projects build installers
# that share the GR 4 install layout and manifest.
if(WIN32 AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/GrInnoSetup.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/GrInnoSetup.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GrInstall.cmake")
incldue("${CMAKE_CURRENT_LIST_DIR}/Utils.cmake")

check_required_components(gnuradio4)
